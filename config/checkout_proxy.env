# gopay-deploy local fixed checkout proxy.
# This project reads this file directly; it does not depend on the old
# gpt协议注册-0419 or Desktop/开通 config.

# Fixed Japan listener from Clash Verge mixed port.
OPAI_OPENAI_CHECKOUT_PROXY=http://127.0.0.1:7897
OPAI_OPENAI_CHECKOUT_REQUIRED_COUNTRY=JP

# Keep legacy variable names too so older helpers in this project resolve the
# same fixed route when needed.
CHECKOUT_LOCAL_PROXY=http://127.0.0.1:17892
OPEN_PRECHECK_REQUIRED_COUNTRY=JP
