# Local runtime defaults. Keep real secrets out of this file unless this
# machine is trusted.

# Required for live registration/worker runs:
# OPAI_HEROSMS_API_KEY=
# OPAI_HEROSMS_API_KEY_FILE=
OPAI_HEROSMS_SERVICE=ni
OPAI_HEROSMS_COUNTRY=6

# Local payment inbox server used by start_inbox.sh / start_worker.sh.
OPAI_PAYMENT_INBOX_BASE_URL=http://127.0.0.1:19080
OPAI_PAYMENT_INBOX_PORT=19080
OPAI_PAYMENT_INBOX_PATH=config/payment_inbox.json

# Leave these blank for open local-only access. Set both to require Basic Auth.
OPAI_PAYMENT_INBOX_BASIC_USER=
OPAI_PAYMENT_INBOX_BASIC_PASS=

# Worker defaults.
OPAI_GOPAY_POLL_INTERVAL=10
OPAI_GOPAY_MIN_REMAINING_SEC=300
OPAI_GOPAY_DEFAULT_PIN=000000
OPAI_GOPAY_MIN_BALANCE_RP=1
OPAI_GOPAY_ACCOUNT_TTL_SEC=1200
OPAI_GOPAY_ACCOUNTS_FILE=config/gopay_worker_accounts.json

# External GoPay envelope links are disabled; only system activation balance is used.

# Optional proxy settings:
# Dynamic proxy: random SID per registration → different IP from proxy pool
OPAI_GOPAY_REGISTER_PROXY=socks5://REDACTED:REDACTED@proxy.example.com:1080
OPAI_GOPAY_DEFAULT_PROXY=socks5://REDACTED:REDACTED@proxy.example.com:1080
OPAI_GOPAY_PROXY_TEMPLATE=
OPAI_GOPAY_PROXY_PROBE_TIMEOUT_SEC=12
OPAI_GOPAY_SSO_TIMEOUT_SEC=30
OPAI_GOPAY_SSO_RETRIES=3
OPAI_GOPAY_SSO_RETRY_SLEEP_SEC=5
